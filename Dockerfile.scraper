FROM mcr.microsoft.com/playwright/python:v1.49.0-noble

WORKDIR /app

# Installation de Node.js 20 pour exécuter l'ingestion directement dans le conteneur
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Installation des dépendances Python du scraper
COPY scripts/scraper/requirements.txt ./scripts/scraper/
RUN pip install --no-cache-dir -r scripts/scraper/requirements.txt

# Montage dynamique des volumes en local, copie des fichiers de référence par défaut
COPY scripts/ ./scripts/
COPY src/ ./src/
COPY package.json ./

CMD ["bash", "scripts/refresh_market_data.sh"]
